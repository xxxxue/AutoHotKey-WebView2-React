{
  "name": "autohotkey-webview2-react",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "npm run ts:check && npm run build:web && npm run gen:assets && npm run build:ahk",
    "build2": "npm run build:web && npm run gen:assets && npm run build:ahk",
    "build:ahk": "ahk64 compile /in src-ahk/main.ahk /compress 0",
    "build:web": "vite build",
    "gen:assets": "tsx scripts/gen-ahk-assets-file.ts",
    "gen:fn": "tsx scripts/gen-ahk-fn-wrapper.ts",
    "ts:check": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint --fix",
    "update-git-hooks": "npx simple-git-hooks"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.0",
    "@ebay/nice-modal-react": "^1.2.13",
    "ahooks": "^3.9.6",
    "antd": "^6.0.0",
    "classnames": "^2.5.1",
    "dayjs": "^1.11.19",
    "immer": "^11.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.9.6"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^6.2.0",
    "@eslint-react/eslint-plugin": "^2.2.4",
    "@tailwindcss/vite": "^4.1.17",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "ahk64": "^2.0.19",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.38.0",
    "eslint-plugin-format": "^1.0.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "lint-staged": "^16.2.7",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "sass-embedded": "^1.93.3",
    "simple-git-hooks": "^2.13.1",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "typescript-plugin-css-modules": "^5.2.0",
    "vite": "^7.2.4"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
